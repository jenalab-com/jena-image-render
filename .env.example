# Copy to .env and fill in, or enter the keys in `jenair ui` → Settings, which
# writes .env for you. Nothing here is needed to render on your own ComfyUI.

# To rent a GPU (--runpod): https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# For private or gated Hugging Face files, and for JENA_STORAGE below (then
# with write access). Sent only to huggingface.co.
HF_TOKEN=

# Render on RunPod by default, without --runpod:
# JENA_TARGET=runpod

# A private Hugging Face repo for your own files: uploaded once, then every
# pod (and your other computers) gets them from there.
# JENA_STORAGE=hf://your-name/your-models

# More settings, rarely needed: docs/config.md#settings
